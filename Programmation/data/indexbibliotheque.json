  "architecture": {
    "repertoire_fiches": "Programmation/data/bibliotheque/fiches/",
    "interface": "Programmation/bibliotheque.html",
    "veille": "Programmation/veillepedagogie.html",
    "principe": "Chaque fiche est lisible par un humain et exploitable par Synapses. Le champ Travail traduit la pensée en leviers de préparation ; le champ Culture/Recherche assure la contextualisation et la veille.",
    "frise": "La chronologie est présentée verticalement, par grandes périodes, avec un court repère permettant de comprendre pourquoi chaque jalon compte. Elle complète, sans la remplacer, la lecture des filiations.",
    "nombre_fiches_pedagogues": 27,
    "principe_equilibre": "La bibliothèque distingue pensée historique, traduction pratique, recherche actuelle et veille. Une fiche n’est pas une preuve d’efficacité d’une méthode.",
    "relations": {
      "influence": "A contribue explicitement ou de manière documentée à la pensée ou aux pratiques de B.",
      "prolongement": "B reprend une idée, une question ou une pratique de A en la transformant ou en la développant.",
      "convergence": "A et B développent des idées proches sans qu'une influence directe soit établie.",
      "dialogue": "Les deux pensées peuvent être mises en regard, sans supposer une filiation directe.",
      "fondement_theorique": "Un auteur ou un courant fournit des concepts qui éclairent une approche pédagogique ; ce n'est pas nécessairement une méthode pédagogique."
    }
  },
