    "legende_relations": [
      {
        "type": "influence",
        "label": "INFLUENCE",
        "definition": "A contribue explicitement ou de manière documentée à la pensée ou aux pratiques de B."
      },
      {
        "type": "prolongement",
        "label": "PROLONGEMENT",
        "definition": "B reprend une idée, une question ou une pratique de A en la transformant ou en la développant."
      },
      {
        "type": "convergence",
        "label": "CONVERGENCE",
        "definition": "A et B développent des idées proches sans qu'une influence directe soit établie."
      },
      {
        "type": "dialogue",
        "label": "DIALOGUE",
        "definition": "Les deux pensées peuvent être mises en regard, sans supposer une filiation directe."
      },
      {
        "type": "fondement_theorique",
        "label": "ÉCLAIRAGE THÉORIQUE",
        "definition": "Un auteur ou un courant fournit des concepts qui éclairent une approche pédagogique ; ce n'est pas nécessairement une méthode pédagogique."
      }
    ]
  }
