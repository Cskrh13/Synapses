{
  "_MODE_EMPLOI": {
    "version": "1.1",
    "role": "Ce fichier organise la structure administrative et chronologique de la programmation pédagogique de Synapses.",
    "source_primaire": "Les documents PDF et autres documents de référence fournis pour construire ou corriger la programmation.",
    "hierarchie": "niveau > discipline > domaine > sequence > seances",
    "regles": [
      "Ne jamais inventer une séquence ou une séance absente des sources fournies.",
      "Conserver les identifiants existants lorsque la donnée existe déjà.",
      "Créer un nouvel identifiant stable uniquement lorsqu'une nouvelle donnée doit être ajoutée.",
      "Ne pas supprimer une donnée existante sans justification explicite.",
      "Une séquence doit toujours être placée sous le niveau, la discipline et le domaine auxquels elle appartient dans les sources.",
      "Une séance doit toujours appartenir à une séquence existante.",
      "Les chemins de fichiers doivent être relatifs à la racine du dossier Programmation.",
      "Le champ competence_id sert à relier une séquence à une compétence ; il ne détermine pas son niveau spatial. Le niveau de index.json reste prioritaire.",
      "Ne pas utiliser ce fichier pour déduire ou inventer des prérequis pédagogiques."
    ],
    "procedure_avec_un_pdf": [
      "Lire le document fourni dans son intégralité avant de modifier les données.",
      "Identifier le niveau, la discipline et le domaine concernés.",
      "Comparer les informations du document avec les entrées déjà présentes dans index.json.",
      "Réutiliser les identifiants existants lorsqu'une donnée correspond déjà.",
      "Ajouter uniquement les séquences et séances réellement justifiées par le document.",
      "Vérifier que chaque séquence possède son niveau, sa discipline et son domaine par sa position dans l'arborescence.",
      "Vérifier que chaque séance possède un sequence_id cohérent et un fichier déclaré si le fichier existe.",
      "Vérifier les doublons et les chemins.",
      "Valider le JSON final avant de le retourner.",
      "Fournir séparément un résumé des ajouts, corrections et ambiguïtés."
    ],
    "index_pedagogique": {
      "optionnel": true,
      "fichier": "data/index-pedagogie.json",
      "regle": "Ce fichier sert de référence analytique pour établir les relations pédagogiques. Son absence ne doit empêcher ni la lecture ni la cartographie de index.json.",
      "role": "Il permet à une IA d'analyser les références pédagogiques et de proposer des relations entre compétences. Les prérequis retenus sont enregistrés dans competences.json.",
      "important": "Ne pas créer un prerequis_competences à partir du seul ordre d'apparition dans index.json."
    }
  },
  "meta": {
    "titre": "Index central de la programmation pédagogique",
    "version": "1.4",
    "description": "Structure administrative et chronologique de la programmation. Le niveau, la discipline et le domaine déterminent la localisation spatiale. Le référentiel complet des compétences est chargé depuis data/competences.json.",
    "competences": "data/competences.json",
    "index_pedagogique": "data/index-pedagogie.json",
    "regle_cartographie": "Le niveau déclaré ici est prioritaire pour le placement d'une séquence et de ses séances. competence_id sert uniquement à créer le lien pédagogique avec une compétence.",
    "regle_prerequis": "Les prérequis pédagogiques sont définis dans competences.json. index-pedagogie.json sert de référence analytique. index.json conserve uniquement les éventuels prérequis explicitement nécessaires à la contextualisation d'une séquence ou d'une séance.",
